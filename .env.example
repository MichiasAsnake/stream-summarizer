# §7 Configuration — copy to .env
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
API_BEARER_TOKEN=dev-token-change-me

# D2 deploy target: mac | local_gpu | cloud_gpu | hosted (see app/deploy.py + deploy/)
DEPLOY_TARGET=mac
# asr: stub | mlx_whisper | whisper_cpp | faster_whisper | hosted
# Defaults resolve from DEPLOY_TARGET (mac→mlx_whisper/small, */gpu→faster_whisper/large-v3-turbo, hosted→hosted)
ASR_BACKEND=stub
ASR_MODEL=small

SPK_EMBED_MODEL=speechbrain/spkrec-ecapa-voxceleb
SPK_MATCH_THRESHOLD=0.55
SPK_MARGIN=0.08
SPK_CLUSTER_THRESHOLD=0.45
SPK_MIN_SEG_SECONDS=1.0

WINDOW_MIN_SECONDS=60
WINDOW_MAX_SECONDS=90
WINDOW_MAX_WORDS=450
WINDOW_MIN_SILENCE=1.5

# D1 content profile: roleplay | gaming | just_chatting
CONTENT_PROFILE=roleplay

# D4 app mode: private | public (public adds guardrails, not multi-tenancy)
APP_MODE=private
TRANSCRIPT_RETENTION_DAYS=365

# D3 consent gate (keep True; voices are biometric data under BIPA/GDPR)
CONSENT_REQUIRED=true
CONSENT_TTL_DAYS=365
UNKNOWN_CLIP_TTL_HOURS=72

# D5 llm provider + budgets
# llm provider: stub | gemini | anthropic | openai_compat
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL_EXTRACT=gemini-2.0-flash
LLM_MODEL_RECAP=gemini-1.5-pro
LLM_SESSION_BUDGET_USD=5.00
LLM_MONTHLY_BUDGET_USD=20.00
LLM_COST_PER_1K_IN=0.0005
LLM_COST_PER_1K_OUT=0.0015

CLASSIFIER=llm
# D6 Jev (experimental, behind flag; needs key unless JEV_MOCK=1 for eval)
JEV_ENABLED=false
JEV_MOCK=false
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.example/v1

SESSION_END_OFFLINE_MINUTES=5
DB_URL=sqlite:///data/app.db
DATA_DIR=./data
