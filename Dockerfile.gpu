# D2: GPU image with faster-whisper + torch (prod ASR per §4)
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04
WORKDIR /srv
RUN apt-get update && apt-get install -y python3.11 python3-pip ffmpeg && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY app ./app
RUN pip3 install -U pip && pip3 install -e ".[asr-gpu,vad,speakers,llm-gemini]"
EXPOSE 8000
CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
